# Backend-only secrets. Never put OSS credentials in any VITE_* variable.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_PREFIX=media/

# Relative paths are based on the project root.
# Production: use /var/lib/media-player-oss/library.json and give the service
# user ownership of its parent directory so temporary files/atomic saves work.
LIBRARY_FILE=data/library.json
FRONTEND_DIST=frontend/dist
LOG_LEVEL=INFO

# JSON array of exact lowercase DNS names / IPv4 addresses; no scheme, wildcard, or port.
# Production example: ["music.example.com","127.0.0.1"] (retain loopback for health checks).
ALLOWED_HOSTS='["localhost","127.0.0.1"]'
# Exact canonical origins, no path/trailing slash/default port. [] for Web only.
ALLOWED_ORIGINS='["capacitor://localhost","https://localhost"]'
# Local Vite development only; true adds exactly http://127.0.0.1:5173.
ENABLE_DEV_ORIGIN=false
