[Unit]
Description=Media Player OSS API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=media-player
Group=media-player
WorkingDirectory=/opt/media-player-oss
# Prepare the Linux Python 3.12 virtual environment before enabling this unit.
# The application reads /opt/media-player-oss/.env; do not use EnvironmentFile.
ExecStart=/opt/media-player-oss/.venv/bin/python /opt/media-player-oss/app.py
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
