# Backend-only secrets. Never put OSS credentials in any VITE_* variable.
OSS_ENDPOINT=https://oss-cn-example.aliyuncs.com
OSS_BUCKET=your-private-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SECURITY_TOKEN=

# One prefix per module inside the same bucket; they must not overlap.
OSS_PREFIX=driver/
NOTE_OSS_PREFIX=my-note/
MEDIA_OSS_PREFIX=media/

PORT=8790
# Relative paths are based on this backend directory.
LIBRARY_FILE=data/library.json
# Built Web UI served on the same port; API-only deployments can point this at a missing directory.
FRONTEND_DIST=../frontend/dist
LOG_LEVEL=INFO

# JSON array of exact lowercase DNS names / IPv4 addresses; no scheme, wildcard, or port.
# Production example: ["drive.example.com","127.0.0.1"] (retain loopback for health checks).
ALLOWED_HOSTS='["localhost","127.0.0.1"]'
# Exact canonical origins, no path/trailing slash/default port. [] for Web only.
# capacitor://localhost is the iOS app, https://localhost the Android app.
ALLOWED_ORIGINS='["capacitor://localhost","https://localhost"]'
# Local Vite development only; true adds exactly http://127.0.0.1:5173. run.sh dev sets it.
ENABLE_DEV_ORIGIN=false

# --- 登录认证（必填）---
# 三项全部填写后数据接口才可访问；缺任意一项时 /api/* 均返回 503。
AUTH_USERNAME=admin
# bcrypt 哈希（交互输入密码）：
# uv run python -c 'import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass("Password: ").encode(), bcrypt.gensalt()).decode())'
AUTH_PASSWORD_HASH=
# 至少 32 字节：uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# 登录有效期（分钟），默认 1440 = 1 天。
JWT_EXPIRE_MINUTES=1440
