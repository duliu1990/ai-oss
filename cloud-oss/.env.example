OSS_ENDPOINT=https://oss-cn-example.aliyuncs.com
OSS_BUCKET=your-private-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SECURITY_TOKEN=
OSS_PREFIX=
# Optional independent Markdown notes path; leave empty to derive it from OSS_PREFIX.
NOTE_OSS_PREFIX=
PORT=8700

# --- 认证配置（可选，不配置则跳过认证）---
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=  # bcrypt 哈希，可用 python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())" 生成
# JWT_SECRET_KEY=  # 随机字符串，可用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
# JWT_EXPIRE_MINUTES=1440
