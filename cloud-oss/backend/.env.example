OSS_ENDPOINT=https://oss-cn-example.aliyuncs.com
OSS_BUCKET=your-private-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_SECURITY_TOKEN=
OSS_PREFIX=
# Optional independent Markdown notes path; leave empty to derive it from OSS_PREFIX.
NOTE_OSS_PREFIX=
PORT=8700

# --- 认证配置 ---
# 可选认证配置。三项全部填写后启用登录保护。
# 生成 bcrypt 哈希（在项目目录运行，交互输入密码）：
# uv run python -c 'import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass("Password: ").encode(), bcrypt.gensalt()).decode())'
# 生成 JWT 密钥：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=
# JWT_SECRET_KEY=
# JWT_EXPIRE_MINUTES=1440
