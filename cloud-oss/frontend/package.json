{
  "name": "driver-oss-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:build": "npm run typecheck && vite build --mode native",
    "ios:sync": "cap sync ios",
    "ios:prepare": "npm run native:build && npm run ios:sync",
    "ios:open": "cap open ios",
    "ios:simulator": "npm run ios:prepare && node scripts/ios-simulator.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@mdxeditor/editor": "4.3.3",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "pptx-preview": "^1.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "x-data-spreadsheet": "^1.1.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^29.1.1",
    "less": "^4.9.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
